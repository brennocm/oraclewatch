# An unreachable endpoint whose URL carries an API key: the monitor reports
# the failure but the key never appears on stdout or stderr, at debug level.
! exec oraclewatch check --config secret.yaml --fail-on warning
! stdout 'sk_live_e2e_secret'
! stderr 'sk_live_e2e_secret'
stdout 'critical +FW-SELF-001 +ethereum +monitor is blind'

! exec oraclewatch validate-config --config secret.yaml --online
! stdout 'sk_live_e2e_secret'
! stderr 'sk_live_e2e_secret'

-- secret.yaml --
networks:
  - name: ethereum
    chain_id: 1
    rpc_endpoints: [{name: keyed, url: "${SECRET_RPC}"}]
    poll_interval: 15s
    call_timeout: 2s
feeds:
  - {name: ETH/USD, network: ethereum, proxy: "0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419", expected_decimals: 8, heartbeat: 1h, deviation_threshold: 0.5%}
log: {level: debug, format: text}
