# Copy to .env (never commit it) and fill in. Every value here is a secret:
# RPC URLs embed API keys, the Discord webhook URL and the Telegram bot token are
# credentials. oraclewatch never logs, exports or sends these values.
#
# Use at least two RPC endpoints per network, ideally from different providers.

ETH_RPC_URL_PRIMARY=https://eth-mainnet.example.invalid/v2/REPLACE_ME
ETH_RPC_URL_SECONDARY=https://ethereum.example.invalid/REPLACE_ME

ARB_RPC_URL_PRIMARY=https://arb-mainnet.example.invalid/v2/REPLACE_ME
ARB_RPC_URL_SECONDARY=https://arbitrum.example.invalid/REPLACE_ME

BASE_RPC_URL_PRIMARY=https://base-mainnet.example.invalid/v2/REPLACE_ME
BASE_RPC_URL_SECONDARY=https://base.example.invalid/REPLACE_ME

OP_RPC_URL_PRIMARY=https://opt-mainnet.example.invalid/v2/REPLACE_ME
OP_RPC_URL_SECONDARY=https://optimism.example.invalid/REPLACE_ME

# Optional notifiers. Leave empty to disable.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional external dead man's switch (e.g. a healthchecks.io ping URL).
DEADMAN_URL=

# docker compose only
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
GRAFANA_DOMAIN=oraclewatch.example.com
ACME_EMAIL=you@example.com
