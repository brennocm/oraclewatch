    {
      "type": "timeseries",
      "title": "Reference sources relative to their pair mean",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Each exchange's mid divided by the mean of all sources for the pair. Spread beyond max_source_spread (1%) makes the reference untrusted (FW-REF-001).",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "oraclewatch_reference_price / on(pair) group_left avg by (pair) (oraclewatch_reference_price)",
          "legendFormat": "{{source}} {{pair}}",
          "refId": "T"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
